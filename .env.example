# Copy this file to .env.local (git ignores it) and fill in the values from your
# Supabase project: Dashboard -> Project Settings -> API Keys, or the "Connect" button.

# Looks like https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Starts with sb_publishable_. Safe in the browser: row level security protects the data.
# Never put the secret key (sb_secret_...) here or in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# For describing meals in words (src/lib/parser). Server only: never prefix it with NEXT_PUBLIC_.
# Create it at https://platform.openai.com/api-keys, and set a monthly budget under
# Settings -> Limits, so a bug or a leaked key can only cost that much.
OPENAI_API_KEY=

# Until the OpenAI key is in place, the parser can use Claude Haiku instead (OpenAI wins when
# both are set). Create the key at https://console.anthropic.com/settings/keys. Keep this name:
# in hosted dev environments, ANTHROPIC_API_KEY is often already set for other tools.
APP_ANTHROPIC_API_KEY=
