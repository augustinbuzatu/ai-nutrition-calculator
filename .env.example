# The template for .env.local, which git ignores: secrets live there, and its
# values win over .env. start.cmd creates it and asks for the key the first time.
# The Supabase project's public settings are in .env, committed for everyone.

# Claude Haiku reads the meals and looks food up on restaurant and shop sites.
# Create the key at https://console.anthropic.com/settings/keys, and set a monthly
# spend limit, so a bug or a leaked key can only cost that much. Keep this name:
# in hosted dev environments, ANTHROPIC_API_KEY is often already set for other tools.
APP_ANTHROPIC_API_KEY=

# Optional: OpenAI reads the meals instead when this is set (the web search stays
# on Claude). Create it at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Optional: the shared demo account behind "Try the demo" on the login page. Create the
# user in the Supabase dashboard (Authentication -> Add user, auto-confirmed) and approve
# it in the ai_access table. Server only: the button signs in with these, so visitors
# never see them. Without both, there is no demo button.
DEMO_EMAIL=
DEMO_PASSWORD=

# To work against a local Supabase instead of the shared project (see CLAUDE.md),
# override NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY here.
