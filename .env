# Committed, and read by Next.js on every machine: public values only.
# Secrets (the AI keys) go in .env.local, which git ignores; values there win.
# A test (scripts/setup.test.mjs) fails if a secret ever lands here.

# The Supabase project everyone's copy of the app uses: Dashboard ->
# Project Settings -> API Keys, or the "Connect" button. Both values are public:
# the publishable key only lets a visitor do what row level security allows.
# Never the secret key (sb_secret_...).
NEXT_PUBLIC_SUPABASE_URL=https://ngwijmxzhulvcijtoyzx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_APwQwZGAsrYiJ5Cx1vk7LA_7iW-D-HD
